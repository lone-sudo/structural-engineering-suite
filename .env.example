# Local/deployment secret; DO NOT COMMIT the real value.
RCC_ADMIN_KEY=replace-with-a-long-random-secret
# The public build is open. Set true only for a managed deployment that
# should require a licence key/PIN.
RCC_REQUIRE_LICENSE=false
# Local development only: set true to bypass the licence screen. NEVER enable in production.
RCC_DEV_MODE=false
# Optional local development license-store path
RCC_LICENSES_FILE=licenses.json
